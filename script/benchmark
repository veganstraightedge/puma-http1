#!/usr/bin/env ruby
# frozen_string_literal: true

# Compares how long Puma::HttpParser, from Puma's puma_http11 C extension,
# and Puma::HTTP1::Parser take to parse the same requests. Run it with the
# JIT to measure, e.g.
#
#   bundle exec ruby --yjit script/benchmark

require "bundler/setup"
require "puma"
require "puma/http1"

ITERATIONS = Integer(ENV.fetch("ITERATIONS", 200_000))

# HTTP requires CRLF line endings, so each heredoc's newlines are converted.
MINIMAL_GET = <<~HTTP.gsub("\n", "\r\n")
  GET / HTTP/1.1
  Host: localhost

HTTP

BROWSER_GET = <<~HTTP.gsub("\n", "\r\n")
  GET /articles/2026/09/hello-world?utm_source=news&ref=home HTTP/1.1
  Host: www.example.com
  User-Agent: Mozilla/5.0 (Macintosh; Intel Mac OS X 14_0) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0 Safari/537.36
  Accept: text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8
  Accept-Language: en-US,en;q=0.9
  Accept-Encoding: gzip, deflate, br
  Connection: keep-alive
  Cookie: session=abc123def456; theme=dark; consent=1
  Cache-Control: max-age=0
  Upgrade-Insecure-Requests: 1
  Sec-Fetch-Dest: document
  Sec-Fetch-Mode: navigate
  Sec-Fetch-Site: none

HTTP

# The body has no trailing newline, hence the chomp.
API_POST = <<~HTTP.chomp.gsub("\n", "\r\n")
  POST /api/v1/orders HTTP/1.1
  Host: api.example.com
  Content-Type: application/json
  Content-Length: 27
  Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIn0.dozjgNryP4J3jVmNHl0w5N_XgL0n3I9PlFUP0THsR8U
  Accept: application/json
  X-Request-Id: 7f1c0e3a-1c2b-4d5e-8f90-123456789abc
  User-Agent: curl/8.7.1

  {"sku":"A1","quantity":2}
HTTP

REQUESTS = {
  "minimal GET" => MINIMAL_GET,
  "browser GET" => BROWSER_GET,
  "API POST" => API_POST
}.freeze

# Returns microseconds per parse of request with parser_class.
def measure(parser_class, request)
  parser = parser_class.new
  request = request.b

  # Each parse gets a fresh copy, as a server would, because the C parser
  # upcases header names inside the buffer it parses.
  1_000.times do
    parser.execute({}, request.dup, 0)
    parser.reset
  end

  started_at = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  ITERATIONS.times do
    parser.execute({}, request.dup, 0)
    parser.reset
  end
  seconds = Process.clock_gettime(Process::CLOCK_MONOTONIC) - started_at

  seconds / ITERATIONS * 1_000_000
end

jit = if defined?(RubyVM::YJIT) && RubyVM::YJIT.enabled? then "YJIT"
      elsif defined?(RubyVM::ZJIT) && RubyVM::ZJIT.enabled? then "ZJIT"
      else "no JIT"
      end

puts "#{RUBY_DESCRIPTION}, #{jit}, #{ITERATIONS} iterations per request"
puts
puts "| request     | Puma::HttpParser µs | Puma::HTTP1::Parser µs | ratio |"
puts "|:------------|--------------------:|----------------------:|------:|"

REQUESTS.each do |name, request|
  c_microseconds = measure(Puma::HttpParser, request)
  ruby_microseconds = measure(Puma::HTTP1::Parser, request)
  ratio = ruby_microseconds / c_microseconds

  puts format("| %<name>-11s | %<c_microseconds>19.2f | %<ruby_microseconds>21.2f | %<ratio>4.1fx |",
              c_microseconds:,
              name:,
              ratio:,
              ruby_microseconds:)
end
